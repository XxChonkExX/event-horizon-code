{
  "name": "event-horizon-code",
  "private": true,
  "version": "0.1.0",
  "main": "out/main/index.js",
  "description": "Event Horizon Code — Desktop-first multi-window coding harness. Local models first. MIT.",
  "license": "MIT",
  "author": {
    "name": "XxChonkExX",
    "url": "https://github.com/XxChonkExX"
  },
  "homepage": "https://github.com/XxChonkExX/event-horizon-code",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XxChonkExX/event-horizon-code.git"
  },
  "bugs": {
    "url": "https://github.com/XxChonkExX/event-horizon-code/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "pack": "electron-builder",
    "pack:dir": "electron-builder --dir",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && npm run engram:test",
    "test:integration": "tsx scripts/smoke-test.ts",
    "engram:test": "node scripts/check-engram.mjs",
    "languages:generate": "node scripts/generate-languages.mjs",
    "skills:generate": "node scripts/generate-skills.mjs",
    "runtime:init": "node scripts/runtime-init.mjs",
    "serve": "node scripts/run-electron-node.mjs node_modules/tsx/dist/cli.mjs scripts/serve.ts",
    "serve:node": "tsx scripts/serve.ts",
    "postinstall": "electron-builder install-app-deps || true",
    "rebuild": "electron-rebuild -f -w better-sqlite3,@lydell/node-pty"
  },
  "dependencies": {
    "@lydell/node-pty": "^1.2.0-beta.18",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "^13.0.3",
    "monaco-editor": "^0.52.0",
    "solid-js": "^1.9.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "electron": "^42.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^5.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vite-plugin-solid": "^2.11.15"
  }
}
