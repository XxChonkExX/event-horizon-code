{
  "name": "event-horizon-code",
  "private": true,
  "version": "0.0.3",
  "main": "out/main/index.js",
  "description": "Event Horizon Code — Desktop-first multi-window coding harness. Local models first. MIT.",
  "license": "MIT",
  "author": {
    "name": "XxChonkExX",
    "email": "hardm210210@gmail.com",
    "url": "https://github.com/XxChonkExX"
  },
  "homepage": "https://github.com/XxChonkExX/event-horizon-code",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XxChonkExX/event-horizon-code.git"
  },
  "bugs": {
    "url": "https://github.com/XxChonkExX/event-horizon-code/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "pack": "npm run build && npm run prepare:engine && electron-builder",
    "pack:dir": "npm run build && npm run prepare:engine && electron-builder --dir",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && npm run wsguard:test && npm run acpsec:test && npm run webfetch:test && npm run secrets:test && npm run templates:test && npm run lsp:test && npm run detonate:test && npm run toolsearch:test && npm run sop:test && npm run sessions:test && npm run runs:test && npm run memory:test && npm run sensory:test && npm run tts:test && npm run engram:test && npm run test:integration",
    "wsguard:test": "tsx scripts/test-wsguard.ts",
    "acpsec:test": "tsx scripts/test-acp-security.ts",
    "webfetch:test": "tsx scripts/test-webfetch.ts",
    "secrets:test": "tsx scripts/test-secrets.ts",
    "secrets:test:electron": "node scripts/run-secrets-electron.mjs",
    "templates:test": "tsx scripts/test-templates.ts",
    "test:integration": "tsx scripts/smoke-test.ts",
    "engram:test": "node scripts/check-engram.mjs",
    "languages:generate": "node scripts/generate-languages.mjs",
    "skills:generate": "node scripts/generate-skills.mjs",
    "runtime:init": "node scripts/runtime-init.mjs",
    "desktop:install": "node scripts/install-desktop.mjs",
    "serve": "node scripts/run-electron-node.mjs node_modules/tsx/dist/cli.mjs scripts/serve.ts",
    "serve:node": "tsx scripts/serve.ts",
    "postinstall": "electron-builder install-app-deps || echo '[ehc] WARN: native dependency install failed - see docs/RUNTIME.md (store falls back to in-memory; node-pty disabled)'",
    "rebuild": "electron-rebuild -f -w better-sqlite3,@lydell/node-pty",
    "lsp:test": "tsx scripts/test-lsp.ts",
    "detonate:test": "tsx scripts/test-detonate.ts",
    "toolsearch:test": "tsx scripts/test-toolsearch.ts",
    "sop:test": "tsx scripts/test-sop.ts",
    "sessions:test": "tsx scripts/test-sessions.ts",
    "runs:test": "tsx scripts/test-agentrun.ts",
    "memory:test": "tsx scripts/test-memory.ts",
    "sensory:test": "tsx scripts/test-sensory.ts",
    "tts:test": "tsx scripts/test-tts.ts",
    "prepare:engine": "node scripts/prepare-engine.mjs",
    "prepare:engine:verify": "node scripts/prepare-engine.mjs --verify"
  },
  "dependencies": {
    "@lydell/node-pty": "^1.2.0-beta.18",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "^13.0.3",
    "monaco-editor": "^0.52.0",
    "solid-js": "^1.9.0",
    "undici": "^8.13.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "electron": "^42.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^5.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-language-server": "^6.1.0",
    "vite": "^7.0.0",
    "vite-plugin-solid": "^2.11.15"
  }
}
