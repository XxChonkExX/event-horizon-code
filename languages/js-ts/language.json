{
  "id": "js-ts",
  "displayName": "JavaScript / TypeScript",
  "tier": 1,
  "fileExtensions": [".js", ".jsx", ".ts", ".tsx", ".mjs", ".cjs", ".mts", ".cts"],
  "toolchain": { "check": ["node --version", "npm --version", "bun --version", "deno --version"] },
  "lsp": { "command": ["typescript-language-server", "--stdio"] },
  "dap": { "command": ["js-debug"] },
  "formatter": { "command": ["prettier", "--write"] },
  "linter": { "command": ["eslint"] },
  "commands": { "build": "npm run build", "test": "npm test", "run": "node {file}" },
  "treeSitter": { "grammar": "typescript" },
  "engramPack": "js-ts",
  "skill": "js-ts-tooling"
}
